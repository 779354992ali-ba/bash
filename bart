// ======================================================
// بيانات الفيديو
// ======================================================

class VideoData {
  final String title;
  final String username;
  final int likes;
  final int comments;
  final Color color1;
  final Color color2;

  const VideoData({
    required this.title,
    required this.username,
    required this.likes,
    required this.comments,
    required this.color1,
    required this.color2,
  });

  String get formattedLikes => _formatCount(likes);
  String get formattedComments => _formatCount(comments);
}

String _formatCount(int value) {
  if (value >= 1000000) return '${(value / 1000000).toStringAsFixed(value % 1000000 == 0 ? 0 : 1)}M';
  if (value >= 1000) return '${(value / 1000).toStringAsFixed(value % 1000 == 0 ? 0 : 1)}K';
  return value.toString();
}

